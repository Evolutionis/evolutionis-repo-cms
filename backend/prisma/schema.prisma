// Schema Prisma — CMS de conteúdo com versionamento e rollback
// Banco: PostgreSQL no Railway (DATABASE_URL injetada automaticamente)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quem pode fazer o quê no painel.
//   EDITOR -> edita conteúdo e publica em homologação (/preview/)
//   ADMIN  -> tudo isso, mais promover para produção e gerenciar usuários
// Publicar em homologação é o uso do dia a dia; promover para o site do
// cliente e mexer em quem tem acesso ficam restritos a ADMIN de propósito.
enum AdminRole {
  ADMIN
  EDITOR
}

// Usuário do painel admin (autenticação JWT, com 2FA opcional por conta)
model AdminUser {
  id           String          @id @default(uuid())
  username     String          @unique
  passwordHash String
  role         AdminRole       @default(EDITOR)
  // Segredo TOTP (RFC 6238) e se o 2FA está de fato ativo. O segredo fica
  // gravado assim que a conta gera o QR code, mas só passa a valer no login
  // depois que o dono confirma um código válido — ver AuthService.enable2fa.
  totpSecret   String?
  totpEnabled  Boolean         @default(false)
  createdAt    DateTime        @default(now())
  versions     ContentVersion[]
}

// Cada publicação gera uma nova versão imutável do conteúdo COMPLETO.
// O conteúdo é guardado como JSON por seção (hero, sobre, etc.) dentro de `content`.
// Rollback = promover o conteúdo de uma versão antiga como nova versão atual.
//
// Dois ambientes, duas marcas:
//   isCurrentHomolog -> o que está no ar em /preview/ (branch de homologação)
//   isCurrentProd    -> o que está no ar na raiz do site (branch de produção)
// A mesma versão costuma ter as duas: é o estado "conferido e promovido".
// Publicar mexe só em homologação; produção só muda por promoção explícita.
model ContentVersion {
  id               String     @id @default(uuid())
  versionNum       Int        @unique @default(autoincrement()) // v1, v2, v3... legível
  content          Json       // { "hero": {...}, "sobre": {...}, "contato": {...} }
  comment          String?    // mensagem opcional do autor ("ajustei o título do hero")
  isCurrentHomolog Boolean    @default(false)
  isCurrentProd    Boolean    @default(false)
  deploySha        String?    // SHA do commit de homologação
  deployShaProd    String?    // SHA do commit de produção (preenchido ao promover)
  promotedAt       DateTime?  // quando esta versão foi para produção
  createdAt        DateTime   @default(now())

  authorId   String?
  author     AdminUser? @relation(fields: [authorId], references: [id])

  @@index([isCurrentHomolog])
  @@index([isCurrentProd])
  @@index([createdAt])
}
