# Banco (o Railway injeta DATABASE_URL sozinho em produção)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/cms

PORT=3000
# De onde o painel chama a API (CORS)
ADMIN_ORIGIN=http://localhost:5173

# Autenticação do painel. O seed cria este usuário na primeira subida.
JWT_SECRET=troque-por-um-segredo-longo
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=troque-esta-senha

# GitHub — é por commit que o conteúdo chega no site
GITHUB_TOKEN=token_com_contents_read_write
GITHUB_OWNER=Evolutionis
GITHUB_REPO=evolutionis-repo-site
CONTENT_PATH=public/content.json
IMAGE_DIR=public/images
IMAGE_PUBLIC_PREFIX=/images

# Os dois ambientes. Cada branch tem seu workflow no repositório do site:
# homolog publica em public_html/preview/, main publica na raiz.
# GITHUB_BRANCH continua valendo como produção, para não quebrar o que já roda.
GITHUB_BRANCH_HOMOLOG=homolog
GITHUB_BRANCH_PROD=main

# Só para desenvolver sem tocar no GitHub: aponta para um clone local do site.
# Se definida, o conteúdo é escrito em disco em vez de virar commit.
# LOCAL_SITE_PATH=../../evolutionis-repo-site
